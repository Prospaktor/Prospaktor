# Environment Variables for NutriTrack App
# Copy this file to .env and fill in your actual API keys

# OpenAI API Key for ChatGPT integration
OPENAI_API_KEY=your_openai_api_key_here

# Nutrition API Key (e.g., Edamam, USDA)
NUTRITION_API_KEY=your_nutrition_api_key_here

# Food Recognition API Key (e.g., Clarifai, Google Vision)
FOOD_RECOGNITION_API_KEY=your_food_recognition_api_key_here

# App Configuration
APP_ENV=development
API_BASE_URL=https://api.nutritrack.app

# Analytics (optional)
GOOGLE_ANALYTICS_ID=your_google_analytics_id_here
MIXPANEL_TOKEN=your_mixpanel_token_here

# Payment Processing (for premium features)
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Social Authentication (optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
FACEBOOK_APP_ID=your_facebook_app_id_here